# ----------------------------------------
# scripts/private/target_configure_strict.cmake
# ----------------------------------------
#
# _cdrk_target_configure_strict( <TARGET_NAME> [ENABLE_EXCEPTIONS] [ENABLE_RTTI] [<option>...] )
#
# Enables warnings as errors on TARGET_NAME and disables exceptions and RTTI unless enabled.
# Any other argument is added as a private compile option.
function( _cdrk_target_configure_strict TARGET_NAME )
    #
    # --- Argument parsing -----------------------------------------------
    # ENABLE_EXCEPTIONS / ENABLE_RTTI: opt-in flags, both OFF unless given.
    # PARSE_ARGV skips TARGET_NAME (index 1).
    #
    cmake_parse_arguments( PARSE_ARGV 1 ARG "ENABLE_EXCEPTIONS;ENABLE_RTTI" "" "" )
    #
    # --- Diagnostics flags --------------------------------------------
    # PRIVATE: these only affect how *this* target is compiled, not its
    # externally visible configuration, therefore they are private.
    #
    target_compile_options(
            ${TARGET_NAME} PRIVATE
            "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:/W4;/WX;/permissive-;/w14062;/w14165;/w14242;/w14254;/w14263;/w14265;/w14287;/w14296;/w14311;/w14545;/w14546;/w14547;/w14549;/w14555;/w14619;/w14640;/w14826;/w14905;/w14906;/w14928;/fp:precise;/Zc:__cplusplus;/Zc:inline;/Zc:preprocessor>"
            "$<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang,AppleClang>:-Wall;-Wextra;-Wpedantic;-Werror;-Wshadow;-Wnon-virtual-dtor;-Wold-style-cast;-Wcast-align;-Wunused;-Woverloaded-virtual;-Wconversion;-Wsign-conversion;-Wdouble-promotion;-Wformat=2;-Wno-unknown-pragmas>"
            ${ARG_UNPARSED_ARGUMENTS} )
    #
    # --- ABI-affecting flags ------------------------------------------
    # PUBLIC, CXX-only: exception/RTTI configuration is baked into any
    # exported C++20 module BMI. If a consumer target links this one but
    # was compiled with a different setting, clang/MSVC rejects the .pcm
    # with a "configuration mismatch". For this reason these are public.
    #
    if( ARG_ENABLE_EXCEPTIONS )
        #
        set( _msvc_eh_flag "/EHsc" )
        set( _gnu_exception_flag "-fexceptions" )
        set( ARG_ENABLE_EXCEPTIONS ON )
        #
    else()
        #
        set( _msvc_eh_flag "/EHs-c-" )
        set( _gnu_exception_flag "-fno-exceptions" )
        set( ARG_ENABLE_EXCEPTIONS OFF )
        #
    endif()
    #
    if( ARG_ENABLE_RTTI )
        #
        set( _msvc_rtti_flag "/GR" )
        set( _gnu_rtti_flag "-frtti" )
        set( ARG_ENABLE_RTTI ON )
        #
    else()
        #
        set( _msvc_rtti_flag "/GR-" )
        set( _gnu_rtti_flag "-fno-rtti" )
        set( ARG_ENABLE_RTTI OFF )
        #
    endif()
    #
    target_compile_options(
            ${TARGET_NAME} PUBLIC
            "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:${_msvc_eh_flag};${_msvc_rtti_flag}>"
            "$<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang,AppleClang>:${_gnu_exception_flag};${_gnu_rtti_flag}>" )
    #
    # _HAS_EXCEPTIONS=0 must only be defined when exceptions are disabled.
    if( NOT ARG_ENABLE_EXCEPTIONS )
        target_compile_definitions( ${TARGET_NAME} PUBLIC "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:_HAS_EXCEPTIONS=0>" )
    endif()
    #
    message( STATUS "${TARGET_NAME}: strict compilation options applied (EXCEPTIONS=${ARG_ENABLE_EXCEPTIONS}, RTTI=${ARG_ENABLE_RTTI})." )
    #
endfunction()

#
# ----------------------------------------
# scripts/private/add_library_target.cmake
# ----------------------------------------
#
# _cdrk_target_export_api( <TARGET_NAME> <EXPORT_MACRO> <STATIC|BUILD|IMPORT> )
#
# Defines EXPORT_MACRO on TARGET_NAME: empty for STATIC, symbol export while compiling
# the target for BUILD, symbol import for its consumers for IMPORT.
function( _cdrk_target_export_api TARGET_NAME EXPORT_MACRO MODE )
    #
    # 1. Pick the export/import attributes for the current platform.
    if( WIN32 OR CYGWIN )
        #
        set( EXPORT_ATTRIBUTE "__declspec(dllexport)" )
        set( IMPORT_ATTRIBUTE "__declspec(dllimport)" )
        #
    elseif( CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang|IntelLLVM)$" )
        #
        set( EXPORT_ATTRIBUTE "__attribute__((visibility(\"default\")))" )
        set( IMPORT_ATTRIBUTE "${EXPORT_ATTRIBUTE}" )
        #
    else()
        #
        message( FATAL_ERROR "${TARGET_NAME}: cannot define ${EXPORT_MACRO}, unsupported compiler '${CMAKE_CXX_COMPILER_ID}'!" )
        #
    endif()
    #
    # 2. Define the macro: empty for static, export while building, import for consumers.
    if( MODE STREQUAL "STATIC" )
        #
        target_compile_definitions( ${TARGET_NAME} PUBLIC "${EXPORT_MACRO}=" )
        #
    elseif( MODE STREQUAL "BUILD" )
        #
        target_compile_definitions( ${TARGET_NAME} PRIVATE "${EXPORT_MACRO}=${EXPORT_ATTRIBUTE}" )
        set_target_properties( ${TARGET_NAME} PROPERTIES
                               CXX_VISIBILITY_PRESET hidden
                               VISIBILITY_INLINES_HIDDEN ON )
        #
    elseif( MODE STREQUAL "IMPORT" )
        #
        target_compile_definitions( ${TARGET_NAME} INTERFACE "${EXPORT_MACRO}=${IMPORT_ATTRIBUTE}" )
        #
    else()
        #
        message( FATAL_ERROR "_cdrk_target_export_api: unknown mode '${MODE}'!" )
        #
    endif()
    #
endfunction()

# _cdrk_add_library_target( <STATIC|SHARED|LIBRARY> <TARGET_NAME> <ALIAS_NAME> <OUT_SOURCE_TARGET> [<source>...] )
#
# Adds the library targets and aliases, see cdrk_module. OUT_SOURCE_TARGET receives the target
# compiling the sources (the object library for LIBRARY), where compile settings belong.
function( _cdrk_add_library_target LIB_TYPE TARGET_NAME ALIAS_NAME OUT_SOURCE_TARGET )
    #
    set( SOURCE_FILES ${ARGN} )
    #
    string( TOUPPER "${TARGET_NAME}_EXPORT" EXPORT_MACRO )
    string( MAKE_C_IDENTIFIER "${EXPORT_MACRO}" EXPORT_MACRO )
    #
    if( LIB_TYPE STREQUAL "STATIC" )
        #
        # Add static library only.
        add_library( ${TARGET_NAME} STATIC ${SOURCE_FILES} )
        add_library( ${ALIAS_NAME} ALIAS ${TARGET_NAME} )
        _cdrk_target_export_api( ${TARGET_NAME} ${EXPORT_MACRO} STATIC )
        #
        set( SOURCE_TARGET ${TARGET_NAME} )
        #
    elseif( LIB_TYPE STREQUAL "SHARED" )
        #
        # Add shared library only.
        add_library( ${TARGET_NAME} SHARED ${SOURCE_FILES} )
        add_library( ${ALIAS_NAME} ALIAS ${TARGET_NAME} )
        _cdrk_target_export_api( ${TARGET_NAME} ${EXPORT_MACRO} BUILD )
        _cdrk_target_export_api( ${TARGET_NAME} ${EXPORT_MACRO} IMPORT )
        #
        set( SOURCE_TARGET ${TARGET_NAME} )
        #
    elseif( LIB_TYPE STREQUAL "LIBRARY" )
        #
        set( OBJECT_TARGET "${TARGET_NAME}-object" )
        set( STATIC_TARGET "${TARGET_NAME}-static" )
        #
        # Add the object library with the sources, PIC since it is linked into the shared one.
        add_library( ${OBJECT_TARGET} OBJECT ${SOURCE_FILES} )
        set_target_properties( ${OBJECT_TARGET} PROPERTIES POSITION_INDEPENDENT_CODE ON )
        _cdrk_target_export_api( ${OBJECT_TARGET} ${EXPORT_MACRO} BUILD )
        #
        # Add static/shared library targets and link them against object.
        add_library( ${STATIC_TARGET} STATIC )
        add_library( "${ALIAS_NAME}-static" ALIAS ${STATIC_TARGET} )
        target_link_libraries( ${STATIC_TARGET} PUBLIC ${OBJECT_TARGET} )
        set_target_properties( ${STATIC_TARGET} PROPERTIES OUTPUT_NAME ${TARGET_NAME} )
        _cdrk_target_export_api( ${STATIC_TARGET} ${EXPORT_MACRO} STATIC )
        #
        add_library( ${TARGET_NAME} SHARED )
        add_library( ${ALIAS_NAME} ALIAS ${TARGET_NAME} )
        target_link_libraries( ${TARGET_NAME} PUBLIC ${OBJECT_TARGET} )
        _cdrk_target_export_api( ${TARGET_NAME} ${EXPORT_MACRO} IMPORT )
        #
        # On Windows the static and import libraries would both be named <name>.lib.
        if( WIN32 )
            #
            set_target_properties( ${STATIC_TARGET} PROPERTIES OUTPUT_NAME "${TARGET_NAME}-static" )
            #
        endif()
        #
        set( SOURCE_TARGET ${OBJECT_TARGET} )
        #
    else()
        #
        message( FATAL_ERROR "_cdrk_add_library_target: library type '${LIB_TYPE}' is not recognized!" )
        #
    endif()
    #
    set( ${OUT_SOURCE_TARGET} ${SOURCE_TARGET} PARENT_SCOPE )
    #
endfunction()


# cdrk_module( <MODULE_NAME> <EXECUTABLE|STATIC|SHARED|LIBRARY>
#              [SOURCES <file>...]
#              [INCLUDE_DIRECTORY <dir>]
#              [SOURCE_DIRECTORY <dir>]
#              [STRICT | STRICT_ARGS <arg>...] )
#
# Adds the target <namespace>_<MODULE_NAME> with alias <namespace>::<MODULE_NAME>, where
# <namespace> is read from ${PROJECT_NAME}_NAMESPACE. If no namespace is defined, the
# target is defined as <MODULE_NAME> with no alias. The complete target name is returned
# in MODULE_TARGET_NAME on the parent scope.
# EXECUTABLE:         an executable, runtime DLLs are copied next to it on Windows.
# STATIC/SHARED:      a single library of that type.
# LIBRARY:            both, sources compiled once; the static one is <namespace>::<MODULE_NAME>-static.
# Libraries define <NAMESPACE>_<MODULE_NAME>_EXPORT (upper case) to mark exported symbols.
# INCLUDE_DIRECTORY:  public headers, default ${CMAKE_CURRENT_SOURCE_DIR}/include.
# SOURCE_DIRECTORY:   private headers, default ${CMAKE_CURRENT_SOURCE_DIR}/source.
# STRICT:             applies strict compilation options with their defaults.
# STRICT_ARGS:        applies strict compilation options with these arguments
#                     (ENABLE_EXCEPTIONS, ENABLE_RTTI, extra compile options).
function( cdrk_module MODULE_NAME MODULE_TYPE )
    #
    # 1. Parse and validate arguments.
    cmake_parse_arguments( PARSE_ARGV 2 ARG "STRICT" "INCLUDE_DIRECTORY;SOURCE_DIRECTORY" "SOURCES;STRICT_ARGS" )
    #
    if( ARG_UNPARSED_ARGUMENTS )
        #
        message( FATAL_ERROR "cdrk_module: unexpected arguments '${ARG_UNPARSED_ARGUMENTS}'!" )
        #
    endif()
    #
    # STRICT_ARGS implies STRICT, even if left empty.
    if( DEFINED ARG_STRICT_ARGS OR "STRICT_ARGS" IN_LIST ARG_KEYWORDS_MISSING_VALUES )
        #
        set( ARG_STRICT ON )
        #
    endif()
    #
    if( NOT DEFINED "${PROJECT_NAME}_NAMESPACE" )
        #
        set( MODULE_NAMESPACE "" )
        set( TARGET_NAME "${MODULE_NAME}" )
        set( ALIAS_NAME "::${MODULE_NAME}" )
        #
    else()
        #
        set( MODULE_NAMESPACE "${${PROJECT_NAME}_NAMESPACE}" )
        set( TARGET_NAME "${MODULE_NAMESPACE}_${MODULE_NAME}" )
        set( ALIAS_NAME "${MODULE_NAMESPACE}::${MODULE_NAME}" )
        #
    endif( )
    #
    # Default directories, unless given through args.
    if( NOT DEFINED ARG_INCLUDE_DIRECTORY )
        #
        set( ARG_INCLUDE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/include" )
        #
    endif()
    #
    if( NOT DEFINED ARG_SOURCE_DIRECTORY )
        #
        set( ARG_SOURCE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/source" )
        #
    endif()
    #
    # 2. Add the module target.
    if( MODULE_TYPE STREQUAL "EXECUTABLE" )
        #
        add_executable( "${TARGET_NAME}" ${ARG_SOURCES} )
        add_executable( "${ALIAS_NAME}" ALIAS "${TARGET_NAME}" )
        set( SOURCE_TARGET "${TARGET_NAME}" )
        #
        # Windows has no rpath, so copy the runtime DLLs next to the executable ('true' if none).
        if( WIN32 )
            #
            set( RUNTIME_DLLS "$<TARGET_RUNTIME_DLLS:${TARGET_NAME}>" )
            add_custom_command( TARGET "${TARGET_NAME}" POST_BUILD
                                COMMAND "${CMAKE_COMMAND}" -E "$<IF:$<BOOL:${RUNTIME_DLLS}>,copy_if_different,true>" "${RUNTIME_DLLS}" "$<TARGET_FILE_DIR:${TARGET_NAME}>"
                                COMMAND_EXPAND_LISTS VERBATIM )
            #
        endif()
        #
    elseif( MODULE_TYPE STREQUAL "STATIC" OR MODULE_TYPE STREQUAL "SHARED" OR MODULE_TYPE STREQUAL "LIBRARY" )
        #
        _cdrk_add_library_target( ${MODULE_TYPE} "${TARGET_NAME}" "${ALIAS_NAME}" SOURCE_TARGET ${ARG_SOURCES} )
        #
    else()
        #
        message( FATAL_ERROR "Module type '${MODULE_TYPE}' is not recognized!" )
        #
    endif()
    #
    # 3. Export as <namespace>::<MODULE_NAME> instead of <namespace>::<namespace>_<MODULE_NAME>.
    set_target_properties( "${TARGET_NAME}" PROPERTIES EXPORT_NAME "${MODULE_NAME}" )
    if( MODULE_TYPE STREQUAL "LIBRARY" )
        #
        set_target_properties( "${TARGET_NAME}-static" PROPERTIES EXPORT_NAME "${MODULE_NAME}-static" )
        set_target_properties( "${TARGET_NAME}-object" PROPERTIES EXPORT_NAME "${MODULE_NAME}-object" )
        #
    endif()
    #
    # 4. Configure the target that compiles the sources and...
    target_include_directories( "${SOURCE_TARGET}"
                                PUBLIC "$<BUILD_INTERFACE:${ARG_INCLUDE_DIRECTORY}>"
                                PRIVATE "${ARG_SOURCE_DIRECTORY}" )
    #
    # ... if args ask for it, apply strict options.
    if( ARG_STRICT )
        #
        _cdrk_target_configure_strict( "${SOURCE_TARGET}" ${ARG_STRICT_ARGS} )
        #
    endif()
    #
    set( MODULE_TARGET_NAME "${TARGET_NAME}" PARENT_SCOPE )
    #
endfunction()

#
message( STATUS "CDrake v${CDRK_VERSION} toolkit loaded." )
#
#
# ========================================
# UPDATE CHECK
# ========================================
#
#
# ----------------------------------------
# scripts/private/check_for_updates.cmake
# ----------------------------------------
#
# _cdrk_check_for_updates()
#
# Warns if the latest CDrake on GitHub is newer than the loaded one. The remote version is
# fetched at most once a day and cached. Disabled by setting CDRK_CHECK_FOR_UPDATES to OFF.
function( _cdrk_check_for_updates )
    #
    if( NOT CDRK_CHECK_FOR_UPDATES )
        #
        return()
        #
    endif()
    #
    # 1. Fetch the latest version from GitHub, at most once a day.
    string( TIMESTAMP NOW "%s" UTC )
    if( DEFINED CACHE{_CDRK_LAST_UPDATE_CHECK} )
        #
        math( EXPR ELAPSED "${NOW} - $CACHE{_CDRK_LAST_UPDATE_CHECK}" )
        #
    endif()
    #
    if( NOT DEFINED ELAPSED OR ELAPSED GREATER_EQUAL 86400 )
        #
        # Store the time first, so being offline does not slow down every configure.
        set( _CDRK_LAST_UPDATE_CHECK "${NOW}" CACHE INTERNAL "" )
        #
        set( REMOTE_CONFIG_FILE "${CMAKE_BINARY_DIR}/_cdrk/CDrakeConfig.cmake" )
        file( DOWNLOAD "https://raw.githubusercontent.com/${CDRK_REPOSITORY}/main/CDrakeConfig.cmake" "${REMOTE_CONFIG_FILE}"
              TIMEOUT 5
              TLS_VERIFY ON
              STATUS DOWNLOAD_STATUS )
        #
        list( GET DOWNLOAD_STATUS 0 DOWNLOAD_CODE )
        if( NOT DOWNLOAD_CODE EQUAL 0 )
            #
            message( STATUS "CDrake update check failed, skipping." )
            return()
            #
        endif()
        #
        # Parse the version from the remote config file and...
        file( READ "${REMOTE_CONFIG_FILE}" REMOTE_CONFIG )
        set( LATEST_VERSION "" )
        foreach( PART MAJOR MINOR PATCH )
            #
            if( NOT REMOTE_CONFIG MATCHES "set\\( CDRK_VERSION_${PART} ([0-9]+) \\)" )
                #
                message( STATUS "CDrake update check could not read the remote version, skipping." )
                return()
                #
            endif()
            list( APPEND LATEST_VERSION "${CMAKE_MATCH_1}" )
            #
        endforeach()
        #
        # ... cache it, so it is reported until updated.
        list( JOIN LATEST_VERSION "." LATEST_VERSION )
        set( _CDRK_LATEST_VERSION "${LATEST_VERSION}" CACHE INTERNAL "" )
        #
    endif()
    #
    # 2. Compare with the loaded version.
    if( DEFINED CACHE{_CDRK_LATEST_VERSION} AND CDRK_VERSION VERSION_LESS $CACHE{_CDRK_LATEST_VERSION} )
        #
        if( CDRK_SINGLE_FILE )
            #
            set( UPDATE_HINT "download https://raw.githubusercontent.com/${CDRK_REPOSITORY}/main/single_file/cdrake.cmake" )
            #
        else()
            #
            set( UPDATE_HINT "pull the latest https://github.com/${CDRK_REPOSITORY}" )
            #
        endif()
        #
        message( WARNING "CDrake v$CACHE{_CDRK_LATEST_VERSION} is available (loaded v${CDRK_VERSION}), ${UPDATE_HINT}. Set CDRK_CHECK_FOR_UPDATES to OFF to disable this check." )
        #
    endif()
    #
endfunction()

_cdrk_check_for_updates()
